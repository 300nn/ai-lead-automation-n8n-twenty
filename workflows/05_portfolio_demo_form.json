        "parameters": {
          "respondWith": "text",
          "responseBody": "<!DOCTYPE html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"UTF-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1.0\">\n  <title>AI Lead Qualification Demo</title>\n  <style>\n    :root{--bg:#090b10;--panel:#11141b;--panel2:#171b24;--border:#262c38;--text:#f5f7fb;--muted:#8e98a9;--accent:#6e7cff;--accent2:#8c63ff;--hot:#ff555d;--warm:#ffad45;--cold:#5b8cff;--ok:#3dcc8e;--danger:#ff6b73}\n    *{box-sizing:border-box} html{color-scheme:dark} body{margin:0;min-height:100vh;background:radial-gradient(circle at 15% 10%,rgba(110,124,255,.13),transparent 30%),radial-gradient(circle at 90% 90%,rgba(140,99,255,.10),transparent 30%),var(--bg);color:var(--text);font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,\"Segoe UI\",sans-serif}\n    .shell{max-width:1180px;margin:0 auto;padding:32px 22px 56px}.top{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:44px}.brand{display:flex;align-items:center;gap:12px;font-weight:760;letter-spacing:-.02em}.logo{width:38px;height:38px;border-radius:12px;background:linear-gradient(135deg,var(--accent),var(--accent2));display:grid;place-items:center;box-shadow:0 12px 35px rgba(110,124,255,.28)}.logo svg{width:22px}.status{display:flex;align-items:center;gap:8px;padding:8px 12px;border:1px solid var(--border);border-radius:999px;color:var(--muted);font-size:12px;background:rgba(17,20,27,.75)}.dot{width:7px;height:7px;background:var(--ok);border-radius:50%;box-shadow:0 0 0 4px rgba(61,204,142,.11)}\n    .grid{display:grid;grid-template-columns:minmax(0,.92fr) minmax(430px,1.08fr);gap:54px;align-items:start}.eyebrow{color:#a9b2ff;font-size:13px;font-weight:720;text-transform:uppercase;letter-spacing:.14em;margin-bottom:14px}.hero h1{font-size:clamp(42px,5vw,68px);line-height:.98;letter-spacing:-.055em;margin:0 0 22px;max-width:720px}.hero h1 span{background:linear-gradient(100deg,#c9ceff,#8b9aff 48%,#a979ff);-webkit-background-clip:text;background-clip:text;color:transparent}.lead{font-size:18px;line-height:1.7;color:#a8b0bf;max-width:620px;margin:0 0 30px}.flow{display:grid;gap:11px;margin-top:34px}.flow-row{display:flex;align-items:center;gap:13px;color:#d6dae3;font-size:14px}.flow-num{width:29px;height:29px;border-radius:9px;border:1px solid #343b4a;background:#151923;display:grid;place-items:center;color:#9fa9ff;font-weight:700;font-size:12px}.meta{display:flex;flex-wrap:wrap;gap:8px;margin-top:28px}.chip{border:1px solid var(--border);background:#11151d;color:#929cac;border-radius:999px;padding:7px 10px;font-size:11px}\n    .card{border:1px solid var(--border);background:linear-gradient(180deg,rgba(20,24,33,.96),rgba(13,16,23,.98));border-radius:22px;padding:26px;box-shadow:0 28px 90px rgba(0,0,0,.34)}.card-head{display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:20px}.card h2{font-size:22px;margin:0 0 6px;letter-spacing:-.025em}.sub{color:var(--muted);font-size:13px}.presets{display:flex;gap:7px;margin:18px 0 22px}.preset{appearance:none;border:1px solid var(--border);background:#151923;color:#aab2c0;border-radius:10px;padding:8px 11px;cursor:pointer;font-weight:700;font-size:11px;transition:.18s}.preset:hover{transform:translateY(-1px);border-color:#485069;color:#fff}.preset.hot:hover{border-color:rgba(255,85,93,.55)}.preset.warm:hover{border-color:rgba(255,173,69,.55)}.preset.cold:hover{border-color:rgba(91,140,255,.55)}\n    form{display:grid;gap:15px}.row{display:grid;grid-template-columns:1fr 1fr;gap:13px}.field{display:grid;gap:7px}label{font-size:12px;font-weight:650;color:#c7ccd6}.optional{font-weight:500;color:#6f7888}input,select,textarea{width:100%;border:1px solid #2a303d;background:#0d1016;color:#f2f4f8;border-radius:11px;padding:12px 13px;outline:none;font:inherit;font-size:13px;transition:.15s}input:focus,select:focus,textarea:focus{border-color:#6574e9;box-shadow:0 0 0 3px rgba(101,116,233,.12)}textarea{min-height:108px;resize:vertical}.hint{font-size:10px;color:#697283}.submit{margin-top:5px;border:0;border-radius:12px;padding:13px 16px;background:linear-gradient(135deg,var(--accent),var(--accent2));color:white;font-weight:760;font-size:14px;cursor:pointer;box-shadow:0 12px 28px rgba(110,124,255,.21);transition:.18s}.submit:hover{transform:translateY(-1px);filter:brightness(1.04)}.submit:disabled{opacity:.58;cursor:wait;transform:none}\n    .result{display:none;margin-top:18px;border:1px solid var(--border);border-radius:15px;background:#0d1016;padding:18px}.result.show{display:block}.result-top{display:flex;justify-content:space-between;align-items:center;gap:12px}.badge{font-size:11px;font-weight:800;letter-spacing:.05em;border-radius:7px;padding:6px 9px}.badge.HOT{background:rgba(255,85,93,.15);color:#ff6e75}.badge.WARM{background:rgba(255,173,69,.15);color:#ffb75d}.badge.COLD{background:rgba(91,140,255,.15);color:#79a0ff}.score{font-weight:800;font-size:25px}.score small{font-size:11px;color:var(--muted);font-weight:600}.meter{height:7px;background:#232936;border-radius:10px;overflow:hidden;margin:13px 0 16px}.meter>div{height:100%;width:0;background:linear-gradient(90deg,var(--accent),var(--accent2));border-radius:10px;transition:width .5s ease}.details{display:grid;grid-template-columns:1fr 1fr;gap:9px}.detail{border:1px solid #202632;border-radius:10px;padding:10px}.detail b{display:block;font-size:10px;color:#717b8d;margin-bottom:4px;text-transform:uppercase;letter-spacing:.06em}.detail span{font-size:12px;overflow-wrap:anywhere}.error{color:#ff8a90}.actions{display:flex;gap:9px;margin-top:14px}.link{flex:1;text-align:center;border:1px solid var(--border);color:#cdd2dc;text-decoration:none;border-radius:10px;padding:9px;font-size:11px;font-weight:700}.link:hover{border-color:#4a5368;color:white}.footer{margin-top:44px;color:#596272;font-size:11px}.loading{display:none;margin-top:14px;color:#9ba4b4;font-size:12px}.loading.show{display:block}.pulse{display:inline-block;width:7px;height:7px;border-radius:50%;background:#8b98ff;margin-right:8px;animation:pulse 1s infinite}@keyframes pulse{50%{opacity:.25}}\n    @media(max-width:900px){.grid{grid-template-columns:1fr;gap:34px}.hero h1{max-width:760px}.card{max-width:650px}.top{margin-bottom:30px}}@media(max-width:560px){.shell{padding:20px 14px 40px}.row{grid-template-columns:1fr}.card{padding:19px;border-radius:17px}.hero h1{font-size:43px}.lead{font-size:16px}.status{display:none}.presets{flex-wrap:wrap}.details{grid-template-columns:1fr}}\n  </style>\n</head>\n<body>\n  <main class=\"shell\">\n    <header class=\"top\">\n      <div class=\"brand\"><div class=\"logo\"><svg viewBox=\"0 0 24 24\" fill=\"none\"><path d=\"M5 12h4l2-6 3.5 12 2-6H20\" stroke=\"white\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"/></svg></div><span>n8n Lead Automation</span></div>\n      <div class=\"status\"><span class=\"dot\"></span>Local demo · Twenty CRM live · AI mock</div>\n    </header>\n\n    <section class=\"grid\">\n      <div class=\"hero\">\n        <div class=\"eyebrow\">Production-like automation</div>\n        <h1>From form submission to <span>qualified opportunity.</span></h1>\n        <p class=\"lead\">Submit a lead and watch the pipeline validate it, score buying intent, upsert a person in Twenty CRM, create an opportunity for HOT leads, send follow-up email, and protect the whole flow with idempotency.</p>\n        <div class=\"flow\">\n          <div class=\"flow-row\"><div class=\"flow-num\">01</div><span>Validate & normalize incoming lead</span></div>\n          <div class=\"flow-row\"><div class=\"flow-num\">02</div><span>Qualify HOT / WARM / COLD with deterministic AI mock</span></div>\n          <div class=\"flow-row\"><div class=\"flow-num\">03</div><span>Sync Person + Opportunity to Twenty CRM</span></div>\n          <div class=\"flow-row\"><div class=\"flow-num\">04</div><span>Send local email through Mailpit + persist state</span></div>\n        </div>\n        <div class=\"meta\"><span class=\"chip\">Webhook API</span><span class=\"chip\">Idempotency</span><span class=\"chip\">Retry / fallback</span><span class=\"chip\">Twenty CRM</span><span class=\"chip\">Mailpit</span><span class=\"chip\">Calendly handler</span></div>\n      </div>\n\n      <div class=\"card\">\n        <div class=\"card-head\"><div><h2>Request a demo</h2><div class=\"sub\">Use a preset or enter your own lead.</div></div></div>\n        <div class=\"presets\"><button class=\"preset hot\" type=\"button\" data-preset=\"hot\">Fill HOT lead</button><button class=\"preset warm\" type=\"button\" data-preset=\"warm\">Fill WARM lead</button><button class=\"preset cold\" type=\"button\" data-preset=\"cold\">Fill COLD lead</button></div>\n        <form id=\"leadForm\">\n          <div class=\"row\">\n            <div class=\"field\"><label for=\"name\">Full name</label><input id=\"name\" name=\"name\" required placeholder=\"Alex Morgan\"></div>\n            <div class=\"field\"><label for=\"email\">Work email</label><input id=\"email\" name=\"email\" type=\"email\" required placeholder=\"alex@company.com\"></div>\n          </div>\n          <div class=\"row\">\n            <div class=\"field\"><label for=\"company\">Company <span class=\"optional\">optional</span></label><input id=\"company\" name=\"company\" placeholder=\"Acme Inc.\"></div>\n            <div class=\"field\"><label for=\"company_size\">Company size</label><input id=\"company_size\" name=\"company_size\" type=\"number\" min=\"0\" value=\"20\"></div>\n          </div>\n          <div class=\"row\">\n            <div class=\"field\"><label for=\"budget\">Budget, USD</label><input id=\"budget\" name=\"budget\" type=\"number\" min=\"0\" value=\"5000\"></div>\n            <div class=\"field\"><label for=\"service\">Service</label><select id=\"service\" name=\"service\" required><option value=\"CRM Automation\">CRM Automation</option><option value=\"Lead Automation\">Lead Automation</option><option value=\"API Integration\">API Integration</option><option value=\"Data cleanup\">Data cleanup</option><option value=\"Reporting\">Reporting</option></select></div>\n          </div>\n          <div class=\"field\"><label for=\"message\">What do you need?</label><textarea id=\"message\" name=\"message\" required placeholder=\"We need to automate inbound leads and CRM routing...\"></textarea><div class=\"hint\">The current local demo keeps OpenAI mocked while Twenty CRM and Mailpit are real.</div></div>\n          <button id=\"submitBtn\" class=\"submit\" type=\"submit\">Qualify lead →</button>\n        </form>\n        <div id=\"loading\" class=\"loading\"><span class=\"pulse\"></span><span id=\"loadingText\">Validating lead...</span></div>\n        <section id=\"result\" class=\"result\" aria-live=\"polite\"></section>\n      </div>\n    </section>\n    <div class=\"footer\">Portfolio demo · n8n + Twenty CRM + Mailpit · All services run locally.</div>\n  </main>\n\n<script>\n(function(){\n  const form=document.getElementById('leadForm'), result=document.getElementById('result'), submit=document.getElementById('submitBtn'), loading=document.getElementById('loading'), loadingText=document.getElementById('loadingText');\n  const presets={\n    hot:{name:'Jordan Lee',email:'jordan@northstar.io',company:'Northstar Labs',company_size:75,budget:15000,service:'CRM Automation',message:'We need sales CRM workflow integration and lead routing automation for our inbound team.'},\n    warm:{name:'Taylor Reed',email:'taylor.reed@gmail.com',company:'Reed Studio',company_size:12,budget:2500,service:'Data cleanup',message:'We need help cleaning our CRM data and improving the current process.'},\n    cold:{name:'Casey Miller',email:'casey.miller@gmail.com',company:'Miller Solo',company_size:2,budget:500,service:'Reporting',message:'I am exploring reporting options for later this year.'}\n  };\n  document.querySelectorAll('[data-preset]').forEach(btn=>btn.addEventListener('click',()=>{const p=presets[btn.dataset.preset];Object.entries(p).forEach(([k,v])=>{const el=form.elements[k];if(el)el.value=v;});result.classList.remove('show');}));\n  const esc=s=>String(s??'').replace(/[&<>\"']/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','\"':'&quot;',\"'\":'&#39;'}[c]));\n  function render(data,httpOk){\n    if(!httpOk || data.status==='invalid' || data.status==='failed'){\n      const errs=(data.errors||[data.error||'Request failed']).map(esc).join('<br>');\n      result.innerHTML='<div class=\"error\"><b>'+esc(data.status||'ERROR')+'</b><div style=\"margin-top:8px;line-height:1.6\">'+errs+'</div></div>'; result.classList.add('show'); return;\n    }\n    const cat=esc(data.category||'N/A'), score=Number(data.score||0), deal=data.deal_id?esc(data.deal_id):'Not required';\n    result.innerHTML='<div class=\"result-top\"><span class=\"badge '+cat+'\">'+cat+'</span><div class=\"score\">'+score+'<small> / 100</small></div></div><div class=\"meter\"><div style=\"width:'+Math.max(0,Math.min(100,score))+'%\"></div></div><div class=\"details\"><div class=\"detail\"><b>Status</b><span>'+esc(data.status)+'</span></div><div class=\"detail\"><b>Email</b><span>'+esc(data.email_status||'n/a')+'</span></div><div class=\"detail\"><b>Twenty Person</b><span>'+esc(data.contact_id||'n/a')+'</span></div><div class=\"detail\"><b>Opportunity</b><span>'+deal+'</span></div><div class=\"detail\"><b>AI provider</b><span>'+esc(data.ai_provider||'n/a')+'</span></div><div class=\"detail\"><b>Request ID</b><span>'+esc(data.request_id||'n/a')+'</span></div></div><div class=\"actions\"><a class=\"link\" target=\"_blank\" rel=\"noreferrer\" href=\"http://localhost:3000\">Open Twenty CRM</a><a class=\"link\" target=\"_blank\" rel=\"noreferrer\" href=\"http://localhost:8025\">Open Mailpit</a></div>';\n    result.classList.add('show');\n  }\n  form.addEventListener('submit',async(e)=>{\n    e.preventDefault(); result.classList.remove('show'); loading.classList.add('show'); submit.disabled=true; submit.textContent='Processing...';\n    const steps=['Validating lead...','Qualifying intent...','Syncing Twenty CRM...','Sending follow-up...']; let i=0; const timer=setInterval(()=>{i=Math.min(i+1,steps.length-1);loadingText.textContent=steps[i];},650);\n    const fd=new FormData(form); const body=Object.fromEntries(fd.entries()); body.company_size=Number(body.company_size||0); body.budget=Number(body.budget||0); body.source='Portfolio Demo Form'; body.request_id='demo-'+Date.now()+'-'+Math.random().toString(36).slice(2,8);\n    try{\n      const res=await fetch('/webhook/portfolio/lead',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(body)}); let data; try{data=await res.json();}catch{data={status:'failed',error:'The webhook returned a non-JSON response.'};} render(data,res.ok);\n    }catch(err){render({status:'failed',error:'Cannot reach the lead webhook: '+err.message},false);}finally{clearInterval(timer);loading.classList.remove('show');submit.disabled=false;submit.textContent='Qualify lead →';}\n  });\n  document.querySelector('[data-preset=\"hot\"]').click();\n})();\n</script>\n</body>\n</html>",
