      {
        "id": "823d6f8e-fb46-4f02-842f-5c037c89e8f1",
        "name": "Normalize Calendly Event",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          260,
          0
        ],
        "parameters": {
          "jsCode": "\nconst b=$json.body??$json;\nconst eventType=String(b.event||b.type||'').trim();\nconst p=b.payload??{};\nconst email=String(p.email||p.invitee?.email||p.contact?.email||'').trim().toLowerCase();\nconst name=String(p.name||p.invitee?.name||p.contact?.name||'').trim();\nconst start_time=p.event?.start_time||p.scheduled_event?.start_time||p.start_time||'';\nconst CONFIG={mockCRM:false,twentyBaseUrl:'http://twenty:3000'};\nconst is_booking=eventType==='invitee.created';\nconst valid=is_booking && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\nreturn [{json:{event_type:eventType,is_booking,valid,email,name,start_time,received_at:new Date().toISOString(),config:CONFIG,raw:b}}];\n"
        }
      },
