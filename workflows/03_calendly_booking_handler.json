        "id": "c4b61e67-404c-4ee5-a26f-891a1e8c14de",
        "name": "Normalize Deal Stage Result",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2080,
          -120
        ],
        "parameters": {
          "jsCode": "\nconst base=$('Booking Context').first().json;\nif($json.deal_update_ok)return [{json:$json}];\nif($json.stage_discovery_ok===false)return [{json:{...base,deal_update_ok:false,deal_update_status:'failed',deal_update_error:$json.deal_update_error||'stage discovery failed'}}];\nconst err=$json.error?(typeof $json.error==='string'?$json.error:JSON.stringify($json.error)):'';\nconst id=$json.id||$json.data?.id||$json.data?.opportunity?.id||$json.data?.updateOpportunity?.id||'';\nconst raw=(()=>{try{return JSON.stringify($json).slice(0,1200)}catch{return '[unserializable response]'}})();\nreturn [{json:{...base,deal_update_ok:!err&&Boolean(id),deal_update_status:err?'failed':'updated',deal_update_error:err||(!id?('missing opportunity id in response; response='+raw):''),selected_stage:$('Choose Booking Stage').first().json.selected_stage||''}}];\n"
        }
