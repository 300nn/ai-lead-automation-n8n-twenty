      {
        "id": "1c56e33c-9321-4d6f-a929-9915a399773f",
        "name": "Choose Booking Stage",
        "type": "n8n-nodes-base.code",
        "typeVersion": 2,
        "position": [
          2080,
          384
        ],
        "parameters": {
          "jsCode": "\nconst base=$('Booking Context').first().json;\nconst httpErr=$json.error?(typeof $json.error==='string'?$json.error:JSON.stringify($json.error)):'';\nconst gqlErr=Array.isArray($json.errors)&&$json.errors.length?JSON.stringify($json.errors):'';\nif(httpErr||gqlErr) return [{json:{...base,stage_discovery_ok:false,deal_update_error:httpErr||gqlErr}}];\nconst values=($json.data?.__type?.enumValues||[]).map(x=>x.name).filter(Boolean);\nif(!values.length) return [{json:{...base,stage_discovery_ok:false,deal_update_error:'OpportunityStageEnum returned no values'}}];\nconst preferred=['MEETING','CONNECTED','TECHNICAL_EVALUATION','SCREENING','PROPOSAL','COMMITTED'];\nlet stage=preferred.find(x=>values.includes(x));\nif(!stage) stage=values.find(x=>!['WON','LOST','CUSTOMER'].includes(x)) || values[0];\nreturn [{json:{...base,stage_discovery_ok:true,selected_stage:stage,available_stages:values}}];\n"
        }
      }
