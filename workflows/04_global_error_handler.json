[{"name":"04 | AI Lead Automation | Global Error Handler","nodes":[{"id":"1ec5a70c-a23f-4769-8927-137e33537221","name":"README","type":"n8n-nodes-base.stickyNote","typeVersion":1,"position":[0,-300],"parameters":{"content":"# 04 — Global error workflow\nAfter import, open the main workflow and Calendly workflow settings and select this workflow under **Error workflow**.\n\nThe Error Trigger is intentionally not connected to external notification APIs: the handler must remain low-risk and should not recursively fail because a third-party service is down.","width":650,"height":240}},{"id":"246365f3-449d-44e3-9a08-e0df4892c00b","name":"Error Trigger","type":"n8n-nodes-base.errorTrigger","typeVersion":1,"position":[0,0],"parameters":{}},{"id":"69973d64-466d-405b-b5f5-cdd0a96ecfce","name":"Normalize Workflow Error","type":"n8n-nodes-base.code","typeVersion":2,"position":[280,0],"parameters":{"jsCode":"\nconst e=$json.execution??{}; const t=$json.trigger??{}; const w=$json.workflow??{};\nconst msg=e.error?.message||t.error?.message||'Unknown workflow error';\nreturn [{json:{timestamp:new Date().toISOString(),request_id:'',stage:'workflow_error',status:'failed',detail:`workflow=${w.name||w.id||'unknown'}; execution=${e.id||'n/a'}; lastNode=${e.lastNodeExecuted||'n/a'}; error=${msg}`,execution_id:String(e.id||'')}}];\n"}},{"id":"39138a58-15e1-4b5c-920a-0fd05696ae03","name":"Audit Unhandled Error","type":"n8n-nodes-base.dataTable","typeVersion":1.1,"position":[560,0],"parameters":{"resource":"row","operation":"insert","dataTableId":{"__rl":true,"value":"lead_automation_audit","mode":"name"},"columns":{"mappingMode":"defineBelow","value":{"timestamp":"={{ $json.timestamp }}","request_id":"={{ $json.request_id }}","stage":"={{ $json.stage }}","status":"={{ $json.status }}","detail":"={{ $json.detail }}","execution_id":"={{ $json.execution_id }}"},"matchingColumns":[],"schema":[{"id":"timestamp","displayName":"timestamp","required":false,"defaultMatch":false,"display":true,"typ